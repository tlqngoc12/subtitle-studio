# Copy to .env and choose your own passwords. .env is git-ignored.
ORACLE_PASSWORD=change-me-sys
SUBTITLESTUDIO_DB_PASSWORD=change-me-app
# Optional: Gemini API key from Google AI Studio for automatic Vietsub (leave empty to turn it off).
GEMINI_API_KEY=
# Optional: Publish the read-only public site to Cloudflare Pages (all three empty = Publish off).
# Token: Cloudflare dashboard → My Profile → API Tokens → Create Token → Custom, permission Account → Cloudflare Pages → Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUBTITLESTUDIO_PUBLISH_PROJECT=
# false (default) = noindex: search engines leave the public site out.
SUBTITLESTUDIO_PUBLISH_INDEXABLE=false
# Optional: text of the watermark drawn on public novel chapter images (empty = <project>.pages.dev).
SUBTITLESTUDIO_NOVEL_WATERMARK=
